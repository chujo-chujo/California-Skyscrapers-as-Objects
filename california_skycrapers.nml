switch (FEAT_OBJECTS, SELF, switch_LA_9_layout, [
    STORE_TEMP(nearby_tile_random_bits(-relative_x, -relative_y), 3),
    relative_pos
    ]) {
    relative_coord(1, 0): layout_LA_9_T1;
    relative_coord(1, 1): layout_LA_9_T2;
    relative_coord(0, 1): layout_LA_9_T3;
    relative_coord(0, 0): layout_LA_9_T4;
}

spritelayout layout_LA_9_menu {
    ground   { sprite: LOAD_TEMP(0); }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: 0;
        yoffset: 0;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: 0;
        yoffset: -16;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: -16;
        yoffset: 0;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: -16;
        yoffset: -16;
        zoffset: -17;
    }
    building { 
        sprite: spriteset_LA_9_menu();
        zoffset: -17;
    }
    building { 
        sprite: spriteset_LA_9_menu_props();
        hide_sprite: param_decoration;
        zoffset: -17;
        recolour_mode: RECOLOUR_REMAP;
        palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(4);
    }
}

switch (FEAT_OBJECTS, SELF, switch_LA_9_menu, [
    STORE_TEMP(convert_day_to_recolour(), 4)
    ]) {
    return layout_LA_9_menu;
}

item (FEAT_OBJECTS, LA_9) {
    property {
        class:                  "GSLA";
        classname:              string(STR_GSLA);
        name:                   string(STR_LA_9);
        climates_available:     ALL_CLIMATES;
        size:                   [2, 2];
        build_cost_multiplier:  8;
        remove_cost_multiplier: 8;
        introduction_date:      param_no_dates == 1 ? 0x00000000 : date(1985, 1, 1);
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           param_remove == 0 ? bitmask(OBJ_FLAG_ANYTHING_REMOVE) : bitmask();
        height:                 4;
        num_views:              1;
    }
    graphics {
        default:         switch_LA_9_layout;
        purchase:        switch_LA_9_menu;
        additional_text: string(STR_LA_9_PURCHASE);
    }
}

