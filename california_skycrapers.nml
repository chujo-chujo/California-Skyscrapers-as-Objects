spriteset (spriteset_LA_1A_menu_props, "gfx/LA_1A.png") { [0, 730, 128, 100, -63, -69] }

spritelayout layout_LA_1A_T1 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: spriteset_snow();
                  hide_sprite: max(nearby_tile_height(-1,0) < snowline_height + 1, param_snow);
                  always_draw: 1; }
    childsprite { sprite: spriteset_LA_1A_ground(0);
                  always_draw: 1; }
    building    { sprite: spriteset_LA_1A_building(0);
                  zextent: 240; }
    childsprite { sprite: spriteset_LA_1A_props(0);
                  hide_sprite: max(nearby_tile_height(-1,0) >= snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3);  }
    building    { sprite: spriteset_LA_1A_building_snow(0);
                  hide_sprite: nearby_tile_height(-1,0) < snowline_height;
                  zextent: 240; }
    childsprite { sprite: spriteset_LA_1A_props_snow(0);
                  hide_sprite: max(nearby_tile_height(-1,0) < snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3); }
}
