spriteset (spriteset_SD_6_building_snow, "gfx/SD_6.png") { tmpl_2x2_building_snow() }
spriteset (spriteset_SD_6_props, "gfx/SD_6.png") { tmpl_2x2_props() }
spriteset (spriteset_SD_6_props_snow, "gfx/SD_6.png") { tmpl_2x2_props_snow() }
spriteset (spriteset_SD_6_menu, "gfx/SD_6.png") { [0, 0, 128, 270, -63, -239] }
spriteset (spriteset_SD_6_menu_props, "gfx/SD_6.png") { [0, 730, 128, 100, -63, -69] }

spritelayout layout_SD_6_T1 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: spriteset_snow();
                  hide_sprite: max(nearby_tile_height(-1,0) < snowline_height + 1, param_snow);
                  always_draw: 1; }
    childsprite { sprite: spriteset_SD_6_ground(0);
                  always_draw: 1; }
    building    { sprite: spriteset_SD_6_building(0);
                  zextent: 240; }
    childsprite { sprite: spriteset_SD_6_props(0);
                  hide_sprite: max(nearby_tile_height(-1,0) >= snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3);  }
    building    { sprite: spriteset_SD_6_building_snow(0);
                  hide_sprite: nearby_tile_height(-1,0) < snowline_height;
                  zextent: 240; }
    childsprite { sprite: spriteset_SD_6_props_snow(0);
                  hide_sprite: max(nearby_tile_height(-1,0) < snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3); }
}
spritelayout layout_SD_6_T2 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: spriteset_snow();
                  hide_sprite: max(nearby_tile_height(-1,-1) < snowline_height + 1, param_snow);
                  always_draw: 1; }
    childsprite { sprite: spriteset_SD_6_ground(1);
                  always_draw: 1; }
    building    { sprite: spriteset_SD_6_building(1);
                  zextent: 240; }
    childsprite { sprite: spriteset_SD_6_props(1);
                  hide_sprite: max(nearby_tile_height(-1,-1) >= snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3); }
    building    { sprite: spriteset_SD_6_building_snow(1);
                  hide_sprite: nearby_tile_height(-1,-1) < snowline_height;
                  zextent: 240; }
    childsprite { sprite: spriteset_SD_6_props_snow(1);
                  hide_sprite: max(nearby_tile_height(-1,-1) < snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3); }
}
spritelayout layout_SD_6_T3 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: spriteset_snow();
                  hide_sprite: max(nearby_tile_height(0,-1) < snowline_height + 1, param_snow);
                  always_draw: 1; }
    childsprite { sprite: spriteset_SD_6_ground(2);
                  always_draw: 1; }
    building    { sprite: spriteset_SD_6_building(2);
                  zextent: 240; }
    childsprite { sprite: spriteset_SD_6_props(2);
                  hide_sprite: max(nearby_tile_height(0,-1) >= snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3); }
    building    { sprite: spriteset_SD_6_building_snow(2);
                  hide_sprite: nearby_tile_height(0,-1) < snowline_height;
                  zextent: 240; }
    childsprite { sprite: spriteset_SD_6_props_snow(2);
                  hide_sprite: max(nearby_tile_height(0,-1) < snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3); }
}
spritelayout layout_SD_6_T4 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: spriteset_snow();
                  hide_sprite: max(nearby_tile_height(0,0) < snowline_height + 1, param_snow);
                  always_draw: 1; }
    building    { sprite: spriteset_SD_6_building(3);
                  zextent: 240; }
    building    { sprite: spriteset_SD_6_building_snow(3);
                  hide_sprite: nearby_tile_height(0,0) < snowline_height;
                  zextent: 240; }
}

switch (FEAT_OBJECTS, SELF, switch_SD_6_layout, [
    STORE_TEMP(nearby_tile_random_bits(-relative_x, -relative_y), 3),
    relative_pos
    ]) {
    relative_coord(1, 0): layout_SD_6_T1;
    relative_coord(1, 1): layout_SD_6_T2;
    relative_coord(0, 1): layout_SD_6_T3;
    relative_coord(0, 0): layout_SD_6_T4;
}

spritelayout layout_SD_6_menu {
    ground   { sprite: LOAD_TEMP(0); }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: 0;
        yoffset: 0;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: 0;
        yoffset: -16;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: -16;
        yoffset: 0;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: -16;
        yoffset: -16;
        zoffset: -17;
    }
    building { 
        sprite: spriteset_SD_6_menu();
        zoffset: -17;
    }
    building { 
        sprite: spriteset_SD_6_menu_props();
        hide_sprite: param_decoration;
        zoffset: -17;
        recolour_mode: RECOLOUR_REMAP;
        palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(4);
    }
}

switch (FEAT_OBJECTS, SELF, switch_SD_6_menu, [
    STORE_TEMP(convert_day_to_recolour(), 4)
    ]) {
    return layout_SD_6_menu;
}

item (FEAT_OBJECTS, SD_6) {
    property {
        class:                  "GSSD";
        classname:              string(STR_GSSD);
        name:                   string(STR_SD_6);
        climates_available:     ALL_CLIMATES;
        size:                   [2, 2];
        build_cost_multiplier:  8;
        remove_cost_multiplier: 8;
        introduction_date:      param_no_dates == 1 ? 0x00000000 : date(1984, 1, 1);
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           param_remove == 0 ? bitmask(OBJ_FLAG_ANYTHING_REMOVE) : bitmask();
        height:                 4;
        num_views:              1;
    }
    graphics {
        default:         switch_SD_6_layout;
        purchase:        switch_SD_6_menu;
        additional_text: string(STR_SD_6_PURCHASE);
    }
}

