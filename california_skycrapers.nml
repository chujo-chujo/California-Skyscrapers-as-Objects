spriteset (spriteset_LA_1A_ground, "gfx/LA_1A.png") { tmpl_2x2_ground() }
spriteset (spriteset_LA_1A_building, "gfx/LA_1A.png") { tmpl_2x2_building() }
spriteset (spriteset_LA_1A_building_snow, "gfx/LA_1A.png") { tmpl_2x2_building_snow() }
