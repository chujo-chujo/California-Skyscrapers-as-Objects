        sprite: spriteset_ground(param_ground);
        xoffset: 0;
        yoffset: 0;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: 0;
        yoffset: -16;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: -16;
        yoffset: 0;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: -16;
        yoffset: -16;
        zoffset: -17;
    }
    building { 
        sprite: spriteset_SF_15_menu();
        zoffset: -17;
