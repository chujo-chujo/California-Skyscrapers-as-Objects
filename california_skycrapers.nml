    ]) {
    return layout_SF_15_menu;
}

item (FEAT_OBJECTS, SF_15) {
    property {
        class:                  "GSSF";
        classname:              string(STR_GSSF);
        name:                   string(STR_SF_15);
        climates_available:     ALL_CLIMATES;
        size:                   [2, 2];
        build_cost_multiplier:  8;
        remove_cost_multiplier: 8;
        introduction_date:      param_no_dates == 1 ? 0x00000000 : date(1985, 1, 1);
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           param_remove == 0 ? bitmask(OBJ_FLAG_ANYTHING_REMOVE) : bitmask();
        height:                 4;
        num_views:              1;
    }
    graphics {
        default:         switch_SF_15_layout;
        purchase:        switch_SF_15_menu;
        additional_text: string(STR_SF_15_PURCHASE);
    }
}

