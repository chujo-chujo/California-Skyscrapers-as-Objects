spriteset (spriteset_SF_31_menu_props, "gfx/SF_31.png") { [0, 730, 128, 100, -63, -69] }

spritelayout layout_SF_31_T1 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: spriteset_snow();
                  hide_sprite: max(nearby_tile_height(-1,0) < snowline_height + 1, param_snow);
                  always_draw: 1; }
    childsprite { sprite: spriteset_SF_31_ground(0);
                  always_draw: 1; }
    building    { sprite: spriteset_SF_31_building(0);
                  zextent: 240; }
    childsprite { sprite: spriteset_SF_31_props(0);
                  hide_sprite: max(nearby_tile_height(-1,0) >= snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3);  }
    building    { sprite: spriteset_SF_31_building_snow(0);
                  hide_sprite: nearby_tile_height(-1,0) < snowline_height;
                  zextent: 240; }
    childsprite { sprite: spriteset_SF_31_props_snow(0);
                  hide_sprite: max(nearby_tile_height(-1,0) < snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3); }
}
spritelayout layout_SF_31_T2 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: spriteset_snow();
                  hide_sprite: max(nearby_tile_height(-1,-1) < snowline_height + 1, param_snow);
                  always_draw: 1; }
    childsprite { sprite: spriteset_SF_31_ground(1);
                  always_draw: 1; }
    building    { sprite: spriteset_SF_31_building(1);
                  zextent: 240; }
    childsprite { sprite: spriteset_SF_31_props(1);
                  hide_sprite: max(nearby_tile_height(-1,-1) >= snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3); }
    building    { sprite: spriteset_SF_31_building_snow(1);
                  hide_sprite: nearby_tile_height(-1,-1) < snowline_height;
                  zextent: 240; }
    childsprite { sprite: spriteset_SF_31_props_snow(1);
                  hide_sprite: max(nearby_tile_height(-1,-1) < snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
