        class:                  "GSSF";
        classname:              string(STR_GSSF);
        name:                   string(STR_SF_27);
        climates_available:     ALL_CLIMATES;
        size:                   [2, 2];
        build_cost_multiplier:  8;
        remove_cost_multiplier: 8;
        introduction_date:      param_no_dates == 1 ? 0x00000000 : date(1969, 1, 1);
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           param_remove == 0 ? bitmask(OBJ_FLAG_ANYTHING_REMOVE) : bitmask();
        height:                 4;
        num_views:              1;
    }
    graphics {
        default:         switch_SF_27_layout;
        purchase:        switch_SF_27_menu;
        additional_text: string(STR_SF_27_PURCHASE);
    }
}

///// SF_28 ////////////////////////////////////////
spriteset (spriteset_SF_28_ground, "gfx/SF_28.png") { tmpl_2x2_ground() }
spriteset (spriteset_SF_28_building, "gfx/SF_28.png") { tmpl_2x2_building() }
spriteset (spriteset_SF_28_building_snow, "gfx/SF_28.png") { tmpl_2x2_building_snow() }
spriteset (spriteset_SF_28_props, "gfx/SF_28.png") { tmpl_2x2_props() }
spriteset (spriteset_SF_28_props_snow, "gfx/SF_28.png") { tmpl_2x2_props_snow() }
spriteset (spriteset_SF_28_menu, "gfx/SF_28.png") { [0, 0, 128, 270, -63, -239] }
spriteset (spriteset_SF_28_menu_props, "gfx/SF_28.png") { [0, 730, 128, 100, -63, -69] }

spritelayout layout_SF_28_T1 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: spriteset_snow();
                  hide_sprite: max(nearby_tile_height(-1,0) < snowline_height + 1, param_snow);
                  always_draw: 1; }
    childsprite { sprite: spriteset_SF_28_ground(0);
                  always_draw: 1; }
    building    { sprite: spriteset_SF_28_building(0);
                  zextent: 240; }
    childsprite { sprite: spriteset_SF_28_props(0);
                  hide_sprite: max(nearby_tile_height(-1,0) >= snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3);  }
    building    { sprite: spriteset_SF_28_building_snow(0);
                  hide_sprite: nearby_tile_height(-1,0) < snowline_height;
                  zextent: 240; }
    childsprite { sprite: spriteset_SF_28_props_snow(0);
                  hide_sprite: max(nearby_tile_height(-1,0) < snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3); }
}
spritelayout layout_SF_28_T2 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: spriteset_snow();
                  hide_sprite: max(nearby_tile_height(-1,-1) < snowline_height + 1, param_snow);
                  always_draw: 1; }
    childsprite { sprite: spriteset_SF_28_ground(1);
                  always_draw: 1; }
    building    { sprite: spriteset_SF_28_building(1);
                  zextent: 240; }
    childsprite { sprite: spriteset_SF_28_props(1);
                  hide_sprite: max(nearby_tile_height(-1,-1) >= snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3); }
    building    { sprite: spriteset_SF_28_building_snow(1);
                  hide_sprite: nearby_tile_height(-1,-1) < snowline_height;
                  zextent: 240; }
    childsprite { sprite: spriteset_SF_28_props_snow(1);
                  hide_sprite: max(nearby_tile_height(-1,-1) < snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3); }
}
spritelayout layout_SF_28_T3 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: spriteset_snow();
                  hide_sprite: max(nearby_tile_height(0,-1) < snowline_height + 1, param_snow);
                  always_draw: 1; }
    childsprite { sprite: spriteset_SF_28_ground(2);
                  always_draw: 1; }
    building    { sprite: spriteset_SF_28_building(2);
                  zextent: 240; }
    childsprite { sprite: spriteset_SF_28_props(2);
                  hide_sprite: max(nearby_tile_height(0,-1) >= snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3); }
    building    { sprite: spriteset_SF_28_building_snow(2);
                  hide_sprite: nearby_tile_height(0,-1) < snowline_height;
                  zextent: 240; }
    childsprite { sprite: spriteset_SF_28_props_snow(2);
                  hide_sprite: max(nearby_tile_height(0,-1) < snowline_height, param_decoration);
                  recolour_mode: RECOLOUR_REMAP;
                  palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(3); }
}
spritelayout layout_SF_28_T4 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: spriteset_snow();
                  hide_sprite: max(nearby_tile_height(0,0) < snowline_height + 1, param_snow);
                  always_draw: 1; }
    building    { sprite: spriteset_SF_28_building(3);
                  zextent: 240; }
    building    { sprite: spriteset_SF_28_building_snow(3);
                  hide_sprite: nearby_tile_height(0,0) < snowline_height;
                  zextent: 240; }
}

switch (FEAT_OBJECTS, SELF, switch_SF_28_layout, [
    STORE_TEMP(nearby_tile_random_bits(-relative_x, -relative_y), 3),
    relative_pos
    ]) {
    relative_coord(1, 0): layout_SF_28_T1;
    relative_coord(1, 1): layout_SF_28_T2;
    relative_coord(0, 1): layout_SF_28_T3;
    relative_coord(0, 0): layout_SF_28_T4;
}

spritelayout layout_SF_28_menu {
    ground   { sprite: LOAD_TEMP(0); }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: 0;
        yoffset: 0;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: 0;
        yoffset: -16;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: -16;
        yoffset: 0;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: -16;
        yoffset: -16;
        zoffset: -17;
    }
    building { 
        sprite: spriteset_SF_28_menu();
        zoffset: -17;
    }
    building { 
        sprite: spriteset_SF_28_menu_props();
        hide_sprite: param_decoration;
        zoffset: -17;
        recolour_mode: RECOLOUR_REMAP;
        palette: magenta_and_cc_recolour_sprites + LOAD_TEMP(4);
    }
}

switch (FEAT_OBJECTS, SELF, switch_SF_28_menu, [
    STORE_TEMP(convert_day_to_recolour(), 4)
    ]) {
    return layout_SF_28_menu;
}

item (FEAT_OBJECTS, SF_28) {
    property {
        class:                  "GSSF";
        classname:              string(STR_GSSF);
