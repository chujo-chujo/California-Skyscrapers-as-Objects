        introduction_date:      param_no_dates == 1 ? 0x00000000 : date(1925, 1, 1);
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           param_remove == 0 ? bitmask(OBJ_FLAG_ANYTHING_REMOVE) : bitmask();
        height:                 4;
        num_views:              1;
    }
    graphics {
        default:         switch_SFB_13_layout;
        purchase:        layout_SFB_13_menu;
        additional_text: string(STR_SFB_13_PURCHASE);
    }
}

///// SFB_14 ////////////////////////////////////////
spriteset (spriteset_SFB_14_ground, "gfx/SFB_14.png") { tmpl_2x2_ground() }
spriteset (spriteset_SFB_14_building, "gfx/SFB_14.png") { tmpl_2x2_building() }
spriteset (spriteset_SFB_14_building_snow, "gfx/SFB_14.png") { tmpl_2x2_building_snow() }
spriteset (spriteset_SFB_14_menu, "gfx/SFB_14.png") { [0, 0, 128, 270, -63, -239] }
spriteset (spriteset_SFB_14_menu_props, "gfx/SFB_14.png") { [0, 730, 128, 100, -63, -69] }

spritelayout layout_SFB_14_T1 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: GROUNDSPRITE_SNOW;
                  hide_sprite: nearby_tile_height(-1,0) < snowline_height + 1;
                  always_draw: 1; }
    childsprite { sprite: spriteset_SFB_14_ground(0);
                  always_draw: 1; }
    building    { sprite: spriteset_SFB_14_building(0);
                  zextent: 240; }
    building    { sprite: spriteset_SFB_14_building_snow(0);
                  hide_sprite: nearby_tile_height(-1,0) < snowline_height;
                  zextent: 240; }
}
spritelayout layout_SFB_14_T2 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: GROUNDSPRITE_SNOW;
                  hide_sprite: nearby_tile_height(-1,-1) < snowline_height + 1;
                  always_draw: 1; }
    childsprite { sprite: spriteset_SFB_14_ground(1);
                  always_draw: 1; }
    building    { sprite: spriteset_SFB_14_building(1);
                  zextent: 240; }
    building    { sprite: spriteset_SFB_14_building_snow(1);
                  hide_sprite: nearby_tile_height(-1,-1) < snowline_height;
                  zextent: 240; }
}
spritelayout layout_SFB_14_T3 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: GROUNDSPRITE_SNOW;
                  hide_sprite: nearby_tile_height(0,-1) < snowline_height + 1;
                  always_draw: 1; }
    childsprite { sprite: spriteset_SFB_14_ground(2);
                  always_draw: 1; }
    building    { sprite: spriteset_SFB_14_building(2);
                  zextent: 240; }
    building    { sprite: spriteset_SFB_14_building_snow(2);
                  hide_sprite: nearby_tile_height(0,-1) < snowline_height;
                  zextent: 240; }
}
spritelayout layout_SFB_14_T4 {
    ground      { sprite: spriteset_ground(param_ground); }
    childsprite { sprite: GROUNDSPRITE_SNOW;
                  hide_sprite: nearby_tile_height(0,0) < snowline_height + 1;
                  always_draw: 1; }
    building    { sprite: spriteset_SFB_14_building(3);
                  zextent: 240; }
    building    { sprite: spriteset_SFB_14_building_snow(3);
                  hide_sprite: nearby_tile_height(0,0) < snowline_height;
                  zextent: 240; }
}

switch (FEAT_OBJECTS, SELF, switch_SFB_14_layout, [relative_pos]) {
    relative_coord(1, 0): layout_SFB_14_T1;
    relative_coord(1, 1): layout_SFB_14_T2;
    relative_coord(0, 1): layout_SFB_14_T3;
    relative_coord(0, 0): layout_SFB_14_T4;
}

spritelayout layout_SFB_14_menu {
    ground   { sprite: LOAD_TEMP(0); }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: 0;
        yoffset: 0;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: 0;
        yoffset: -16;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: -16;
        yoffset: 0;
        zoffset: -17;
    }
    building {
        sprite: spriteset_ground(param_ground);
        xoffset: -16;
        yoffset: -16;
        zoffset: -17;
    }
    building { 
        sprite: spriteset_SFB_14_menu();
        zoffset: -17;
    }
}

item (FEAT_OBJECTS, SFB_14) {
    property {
        class:                  "GSFB";
        classname:              string(STR_GSFB);
        name:                   string(STR_SFB_14);
        climates_available:     ALL_CLIMATES;
        size:                   [2, 2];
        build_cost_multiplier:  8;
        remove_cost_multiplier: 8;
        introduction_date:      param_no_dates == 1 ? 0x00000000 : date(1950, 1, 1);
        end_of_life_date:       0xFFFFFFFF;
        object_flags:           param_remove == 0 ? bitmask(OBJ_FLAG_ANYTHING_REMOVE) : bitmask();
        height:                 4;
        num_views:              1;
    }
    graphics {
        default:         switch_SFB_14_layout;
        purchase:        layout_SFB_14_menu;
        additional_text: string(STR_SFB_14_PURCHASE);
    }
}
